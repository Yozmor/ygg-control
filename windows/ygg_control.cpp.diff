 int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE, PWSTR, int nCmdShow) {
+    // --selftest - для скрипта обновления: exe целиком загрузился (все DLL нашлись)
+    // и графика создаётся. Без прав администратора, без окна, сразу выход.
+    if (wcsstr(GetCommandLineW(), L"--selftest")) {
+        ID2D1Factory* d2 = nullptr;
+        IDWriteFactory* dw = nullptr;
+        bool ok = SUCCEEDED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &d2)) &&
+                  SUCCEEDED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory), (IUnknown**)&dw));
+        if (d2) d2->Release();
+        if (dw) dw->Release();
+        if (!ok) return 1;
+        std::string v = util::ToUtf8(ygg::PANEL_VERSION) + "\n";   // обновление сверяет версию
+        DWORD n = 0;
+        WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), v.data(), (DWORD)v.size(), &n, nullptr);
+        return 0;
+    }
     SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
     CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
 
